# Secrets — never commit
.env
app-secrets.json
dozzle-users.yml

# SSH private keys — never commit (only box.sh + known_hosts are tracked under .ssh/)
.ssh/id_*
.ssh/*rumi_netcup*
*.pem
*.key
*.pfx
*.p12

# Local backups created by on-box edits
*.bak
*.bak.*

# Claude Code per-repo settings (machine-local) — EXCEPT versioned subagents
.claude/*
!.claude/agents/
