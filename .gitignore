# Secrets — never commit
.env
app-secrets.json
dozzle-users.yml

# SSH private keys — never commit (only box.sh + known_hosts are tracked under .ssh/)
.ssh/id_*
.ssh/*rumi_netcup*
*.pem
*.key
*.pfx
*.p12

# Local backups created by on-box edits
*.bak
*.bak.*

# Tenant site blocks are rendered ON THE BOX by provision-tenant.sh — only the
# glob-keeper placeholder is committed (see caddy-tenants/00-placeholder.caddy)
caddy-tenants/*.caddy
!caddy-tenants/00-placeholder.caddy

# Claude Code per-repo settings (machine-local)
.claude/
