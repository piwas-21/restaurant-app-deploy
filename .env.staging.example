# STAGING box .env template. On the staging box: cp .env.staging.example .env and fill in
# (the real file is just ".env" — same gitignored name as prod, since it's a separate box).
# Used by docker-compose.prod.yml (the compose file is shared across both boxes).

# --- Which Caddyfile to mount (this is what makes the shared compose serve staging) ---
CADDYFILE=./Caddyfile.staging

# --- Which box this is (tenant provisioning guard) ---
# provision-tenant.sh/deprovision-tenant.sh refuse to run a tenant whose
# registry entry names a different box (and refuse to guess when unset).
BOX_ROLE=staging

# --- Staging site address (baked into the Caddyfile via {$STAGING_DOMAIN}) ---
# MUST be a name whose DNS zone we control, pointed at this box: Caddy asks Let's
# Encrypt for it on first boot. NEVER the box's Netcup hostname
# (v2202607374190477434.megasrv.de) — that zone is the provider's, we cannot answer
# an ACME challenge for it, so Caddy would hold no certificate and abort every
# HTTPS handshake for that name with `tlsv1 alert internal error` (deploy #146).
# Change this one line to move staging onto a SaaS brand domain later.
STAGING_DOMAIN=staging.fooderist.com

# --- Image versions pulled from GHCR (per service) ---
# Staging tracks `develop`; both services pin their repo's moving :staging tag,
# built on every develop push. (Backend is domain-agnostic so its :staging image
# is byte-identical to that develop build's :sha-<sha>; the frontend's differs
# because it bakes staging NEXT_PUBLIC_* at build time.) Do NOT pin BACKEND_TAG
# to :latest — since 2026-07-16 :latest means main (prod), so it would roll
# staging back to prod code on deploy.
BACKEND_TAG=staging
FRONTEND_TAG=staging

# --- Postgres (fresh, staging-only DB — NEVER point at prod data) ---
POSTGRES_USER=rumi
POSTGRES_DB=restaurantdb
# Generate: openssl rand -base64 32   (trim '/+=' — gen-secrets.sh does this)
POSTGRES_PASSWORD=CHANGE_ME

# --- Sofra marketing site (sofrapiwas.com — staging box only) ---
# Opt in to the sofra compose service (prod never sets this, so `up -d` there
# ignores the service entirely).
COMPOSE_PROFILES=sofra
SOFRA_DOMAIN=sofrapiwas.com
SOFRA_WWW_DOMAIN=www.sofrapiwas.com
SOFRA_TAG=latest
# Waitlist intake -> Resend (https://resend.com). Key format re_... (no $ chars,
# so the compose $-escaping gotcha below doesn't apply here).
RESEND_API_KEY=CHANGE_ME
WAITLIST_TO=CHANGE_ME
# Must be a sender on a Resend-VERIFIED domain. Do NOT use onboarding@resend.dev:
# it reaches ONLY the Resend account owner's address and 403s for everyone else.
WAITLIST_FROM="Sofra <sofra@send.sofrapiwas.com>"
# Monitored mailbox for replies (need not be on the sending domain; sofrapiwas.com
# has no MX, so without this every customer reply hard-bounces).
SUPPORT_REPLY_TO="sofra@piwas.nl"
# Control plane (partner program) — DB role password + Auth.js session secret.
# Generate both with: openssl rand -base64 32   (trim '/+=' for the DB one,
# and remember the $$-escaping rule below if a generated value contains $).
# One-time DB setup + migrate/seed commands: DEPLOYMENT.md "Sofra control plane".
SOFRA_DB_PASSWORD=CHANGE_ME
SOFRA_AUTH_SECRET=CHANGE_ME
SOFRA_APP_URL=https://sofrapiwas.com
# Mollie subscription billing (S9, sofra ADR-011 Job A). API key from the
# sofrapiwas.com Mollie profile: test_... while verifying flows, live_... once
# tenant billing is real. Key format has no $ chars, so no $$-escaping needed.
MOLLIE_API_KEY=CHANGE_ME
# Stripe application-fee refund rail (sofra ADR-011 Job B). These belong HERE and
# nowhere else: this is the box that sets COMPOSE_PROFILES=sofra above, so it is the
# box that runs the control plane and reads them.
#
# SOFRA_STRIPE_API_KEY is a SEPARATE restricted key from the one tenant backends
# use. Refunding an application fee needs `Application fees -> write`, which is
# precisely the power the tenant key is narrowed to NOT have.
#
# Then TWO webhook secrets for ONE URL (https://sofrapiwas.com/api/webhooks/stripe),
# because Stripe's two event scopes are orthogonal, not overlapping. Measured
# 2026-09-04: with no `Stripe-Account` header the platform scope holds
# application_fee.created = 5 and charge.refunded = 0; with
# `Stripe-Account: acct_...` the same query holds application_fee.created = 0 and
# charge.refunded = 2 — that charge.refunded row is the control that makes the two
# zeros trustworthy. So the `connect: true` endpoint hears charge.refunded for every
# connected account, and a SECOND, ACCOUNT-SCOPED endpoint on the same URL hears the
# platform's own application_fee.created (it carries `account: null`, so a Connect
# endpoint will never be handed one). The handler tries the Connect secret first and
# the account secret second.
#
# Leave all three empty until some tenant runs a non-zero payments_commission_bps,
# which today is none of them: empty -> the webhook answers 503 and refunds nothing,
# and everything else on the site still serves. Never guess a `whsec_` — a wrong one
# fails silently, it does not raise.
SOFRA_STRIPE_API_KEY=
SOFRA_STRIPE_CONNECT_WEBHOOK_SECRET=
SOFRA_STRIPE_ACCOUNT_WEBHOOK_SECRET=
# NOTE: the `sofra-staging` profile (staging.sofrapiwas.com) is deliberately not
# modelled anywhere in this file — COMPOSE_PROFILES above lists `sofra` only. If you
# ever add it, copy the matching *_TEST block from .env.example wholesale; that
# service block inherits NOTHING from `sofra`.
# Data-retention cron (POST /api/cron/retention, GDPR storage-limitation).
# SOFRA_CRON_SECRET must MATCH the CRON_SECRET GitHub Actions secret on
# piwas-21/sofra (the daily caller's bearer). DATA-LOSS: nothing is purged unless
# SOFRA_RETENTION_ENABLED=true. Generate the secret: openssl rand -hex 32.
SOFRA_CRON_SECRET=CHANGE_ME
SOFRA_RETENTION_ENABLED=false
# Optional window overrides (app defaults 30d / 18mo / 12mo):
# SOFRA_RETENTION_INVITE_TOKEN_DAYS=30
# SOFRA_RETENTION_AUDIT_LOG_MONTHS=18
# SOFRA_RETENTION_REJECTED_APPLICATION_MONTHS=12
# Provisioning trigger (sofra ADR-012). A FINE-GRAINED GitHub token, scoped to
# piwas-21/restaurant-app-deploy only, permissions Contents: write +
# Pull requests: write — nothing else, and never a classic PAT. It lets
# /admin/provision open the tenant registry PR; the box SSH key stays in Actions
# secrets so this container can propose a tenant but never provision one
# (ADR-012 invariant 2). Empty -> /admin/provision shows "not configured".
# Format is ghp_/github_pat_... (no $ chars, so no $$-escaping needed).
PROVISION_GITHUB_TOKEN=

# --- Developer Portal Basic Auth (/dev-portal) ---
# Bcrypt hash, NOT plaintext. Generate on the box:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'CHOOSE_A_STRONG_PASSWORD'
# IMPORTANT: double every literal $ before pasting (Compose interpolates .env; an
# unescaped $ silently corrupts the hash — see DEPLOYMENT.md).
DEV_PORTAL_AUTH_HASH=CHANGE_ME

# --- Error tracking (Sentry — DEV-PHASES W3) ---
# Empty = disabled. Enables server-side capture for frontend + backend + sofra
# on a recreate (no rebuild). DSN is Sentry SaaS EU; self-host later = swap it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# --- Fleet observability roll-up (Track S) ---
# ONE shared bearer secret for the single sofra control plane (sofrapiwas.com, which runs on
# THIS box). Value = openssl rand -hex 32; must be IDENTICAL here and on the prod box, since
# sofra (here) validates it AND every tenant backend on any box presents it to push. Flowed
# into tenant .envs by provision-tenant.sh. Unset -> the sofra ingest route 503s and pushers
# are inert.
PRINTER_TELEMETRY_SECRET=
# The staging RUMI backend must NOT push to the (single, prod) sofra control plane as "rumi" — it
# would clobber prod's fleet rows. Disable its push here. (Prod box leaves this unset -> defaults on.)
FLEET_PUSH_ENABLED=false

# Seeds the mixed-kitchen bundle the printer-app E2E suite needs to assert kitchen routing
# (backend #238) — staging ships no products otherwise. STAGING ONLY: it inserts a VISIBLE,
# ORDERABLE product, so the prod box must never carry this line. Absent -> the compose default
# (false) applies.
# The value must be literally `true` or `false`. Anything else (0/1/yes/on) fails bool binding,
# which throws out of the startup migration and the backend never reaches app.Run().
SEED_E2E_MENU_FIXTURES=true

# --- Sign in with Apple (mobile app; backend "Authentication:Apple") ---
# NOTHING TO SET HERE, on either box — staging and prod take the SAME value. The accepted
# `aud` is the iOS bundle id of the RUMI app (`com.rumirestaurant.app`, from
# rumi-mobile/app.json) — a PUBLIC identifier shipped inside the app binary, not a secret
# — so it lives in tracked config as the compose default in docker-compose.prod.yml, not
# in this file and not in app-secrets.json.
#
# It is listed here because the backend fails CLOSED: since backend #406 it verifies the
# Apple identity token, and with no client id configured every POST /api/Auth/apple-login
# is refused with 503 AppleLoginUnavailable. Setting the line below EMPTY is harmless —
# compose's `:-` falls back to the default on an empty value as well as an unset one — so
# the way a box loses Apple login is an un-synced release, not a bad .env, and deploy.sh's
# preflight warns when the resolved config carries no audience at all.
# Uncomment ONLY to override, e.g. the day the bundle id changes and the fix cannot wait
# for a release of this repo, or to point staging at a different app build.
# (One of the very few backend settings where staging and prod are deliberately IDENTICAL: the
# app on a tester's phone carries one bundle id whichever box it is pointed at.)
#APPLE_IOS_BUNDLE_ID=com.rumirestaurant.app
# Slot 1: the Apple *web* Service ID, for when Sign in with Apple ships on the website.
# Blank/absent = the app is the only accepted audience.
#APPLE_WEB_SERVICE_ID=

# --- Reservation quick-action mail links (backend "ReservationQuickActions") ---
# NOTHING TO SET HERE. The approve / reject buttons in the restaurant's new-booking alert mail
# are signed since backend #410; a token-LESS link from a mail sent BEFORE that release is still
# honoured while its own booking is younger than the grace window (14 days). The cutoff below —
# the instant the release image began serving on prod — is what stops that window from also
# covering bookings made AFTER the release, which would leave backend #402 (a guest approving
# their own table) reachable for two more weeks. It is a public timestamp, not a secret, so it
# ships as the compose default in docker-compose.prod.yml.
#
# THE FOLLOW-UP, ~2 weeks after the release: once the old alert mails are drained — no
# "Accepted a LEGACY unsigned quick-…" warning in the backend log for a few days — set
#     RESERVATION_QUICK_ACTIONS_LEGACY_GRACE_DAYS=0
# here and `docker compose -f docker-compose.prod.yml up -d backend`. That retires the
# token-less path entirely, with no release of this repo. See DEPLOYMENT.md
# §"Reservation quick-action links".
#
# Do not leave either line present-but-empty as a way to unset them: compose's `:-` substitutes
# the default on an empty value too, so an empty line is inert (and for the day count that is a
# mercy — an empty integer would make the backend THROW on the first link somebody opens).
#RESERVATION_QUICK_ACTIONS_LEGACY_CUTOFF_UTC=2026-08-25T00:52:24Z
#RESERVATION_QUICK_ACTIONS_LEGACY_GRACE_DAYS=14

# --- Sofra's own registration details (sofra ADR-013) ---
# Printed on every invoice AND on the public /legal imprint, from this one source
# so the two can never disagree. Not secrets — a KVK and a VAT number are public
# registry data required on both.
#
# Unset is NOT neutral: sofra refuses to issue ANY invoice until all of these are
# set. That is deliberate — a placeholder KVK number on a real invoice looks
# finished, which is worse than no invoice. /admin/invoices names what is missing.
#
# SOFRA_LEGAL_EMAIL must be a mailbox that RECEIVES: the imprint contact, the
# GDPR data-subject route and "ask us for the terms" all run through it. Check the
# domain has an MX record before setting it.
#
# SOFRA_VAT_NUMBER is also sent to VIES as the requester — the only way a check
# returns a consultation reference, which is the evidence a reverse charge rests on.
SOFRA_LEGAL_NAME=
SOFRA_LEGAL_ADDRESS=
SOFRA_LEGAL_ADDRESS_2=
SOFRA_LEGAL_POSTAL=
SOFRA_LEGAL_CITY=
SOFRA_LEGAL_COUNTRY=NL
SOFRA_LEGAL_EMAIL=
SOFRA_KVK=
SOFRA_VAT_NUMBER=
SOFRA_IBAN=
SOFRA_INVOICE_SERIES=SP

# --- Backup agent (box -> sofra control plane) ---
# Shared bearer this box's backup-agent.sh presents to the control plane's
# POST /api/telemetry/backups (inventory) and GET /api/backups/jobs (work queue).
# `openssl rand -hex 32`. MUST match BACKUP_AGENT_SECRET on the sofra box.
#
# DIRECTION IS THE DESIGN: every credential points BOX -> SOFRA. The control plane
# never holds anything that can reach a box, so a compromised public container can
# ask for a backup and can never provision, deprovision or log into anything
# (ADR-012 invariant 2). That is also why sofra is NOT given a GitHub
# `Actions: write` token to dispatch a backup workflow — that scope cannot be
# narrowed to one workflow, so it would equally dispatch deprovision --drop-db.
#
# WHERE IT IS READ: backup-agent.sh runs on the HOST from cron (*/5), reading this
# file directly — it is not a container, so nothing else is needed on a tenant box.
# The SOFRA container needs the same value to VERIFY the bearer, and for that it is
# declared in docker-compose.prod.yml (a .env var does not reach a container on its
# own). Unset -> the agent exits silently and the route stays inert. Safe to ship.
BACKUP_AGENT_SECRET=
# Where to report. Default https://sofrapiwas.com; override to point a box at a
# staging control plane.
BACKUP_AGENT_URL=
# Whether this box will execute `delete` jobs from the control plane. OFF unless
# it is exactly `true`, deliberately: sofra is the internet-facing half of the
# system, and with this false the worst a compromise of it can do through this
# channel is ask for MORE backups. Whole-tenant erasure is never a job at all —
# it is a deliberate on-box run of backup-erase-tenant.sh.
BACKUP_AGENT_ALLOW_DELETE=false
# How long a DEPARTED tenant's consolidated archive is kept (calendar months).
# Default 24 — see DEPLOYMENT.md §Backups & restore for why that number and not
# "forever". Applies to backup-archive-tenant.sh --prune and to the restic
# --tag tenant-archive series in backup-offsite.sh.
ARCHIVE_KEEP_MONTHS=24
