# Copy to .env and fill in. .env is git-ignored. Used by docker-compose.prod.yml.

# --- Which box this is (tenant provisioning guard) ---
# provision-tenant.sh/deprovision-tenant.sh refuse to run a tenant whose
# registry entry names a different box (and refuse to guess when unset).
BOX_ROLE=prod

# --- Image versions pulled from GHCR (per service) ---
# "latest" tracks the current prod (main). deploy.sh persists whatever tag it
# deploys here, so a rollback survives restarts. Pin a specific build for a
# rollback, e.g. BACKEND_TAG=sha-<commit> or FRONTEND_TAG=v1.2.3.
BACKEND_TAG=latest
FRONTEND_TAG=latest

# --- Postgres (fresh DB; you pick these) ---
POSTGRES_USER=rumi
POSTGRES_DB=restaurantdb
# Generate: openssl rand -base64 32   (avoid characters that break the connection string, e.g. trim '/+=')
POSTGRES_PASSWORD=CHANGE_ME

# Note: NEXT_PUBLIC_* (API URL, Google client ID) are baked into the frontend
# image at CI build time — they are NOT set here. To change them, edit the
# frontend repo's build-image.yml and rebuild.

# --- Developer Portal Basic Auth (/dev-portal) ---
# Bcrypt hash, NOT the plaintext password. Generate on the box:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'CHOOSE_A_STRONG_PASSWORD'
# IMPORTANT: double every literal $ before pasting here (e.g. $2a$14$Gkg... ->
# $$2a$$14$$Gkg...) — Compose interpolates .env values, and an unescaped $ can
# get silently swallowed as an undefined variable reference, corrupting the
# hash. See DEPLOYMENT.md's Developer Portal section for the full explanation.
# Rotate by regenerating the hash and recreating the caddy service.
DEV_PORTAL_AUTH_HASH=CHANGE_ME

# --- Error tracking (Sentry — DEV-PHASES W3) ---
# Empty = disabled (the SDK is a no-op). Enabling server-side capture is just
# this DSN + a recreate of frontend + backend (no image rebuild). DSN is Sentry
# SaaS EU (non-secret by design; self-host later = swap this value — see
# DEPLOYMENT.md).
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod

# --- Fleet observability roll-up (Track S; printer-app → backend → sofra /admin/fleet) ---
# Shared bearer secret each tenant backend's FleetSummaryPushService presents to sofra's
# /api/telemetry/fleet ingest route (openssl rand -hex 32). MUST match the same key on the
# sofra box. Flowed into every tenant .env by provision-tenant.sh — set it ONCE per box and
# new tenants push automatically. Unset -> tenant backends stay inert (no push).
PRINTER_TELEMETRY_SECRET=

# --- Tenant→diner Stripe Connect (ADR-011 Job B, SOFRA-PAYMENTS-PLAN §4) ---
# RUMI's own online-payment wiring. All three are REQUIRED TOGETHER: the backend's gateway
# reports IsConfigured only when Enabled is true AND both values are non-empty, so leaving any
# one of them unset keeps online payment hidden at checkout rather than half-working.
#
# Distinct from Sofra's own Mollie billing, which this never touches. Funds settle DIRECTLY to
# the restaurant's Stripe balance — Connect Standard means the restaurant owns the account and
# its payouts outright, and Sofra takes no commission.
#
# STRIPE_PLATFORM_API_KEY is the BOX's shared restricted key, not a per-tenant one: a Stripe
# restricted key cannot be bound to a single acct_, so it is narrowed by permission
# (checkout_session_write, payment_intent_read, charges_read — and deliberately NO refunds
# write) and by an Access policy pinning it to the box IPs. Same rail as
# PRINTER_TELEMETRY_SECRET above.
#
# STRIPE_CONNECTED_ACCOUNT_ID is RUMI's own acct_..., which only exists once the restaurant has
# completed Stripe's KYC onboarding. Setting STRIPE_ENABLED=true without it does nothing.
#
# ⚠️ docker-compose.prod.yml runs on BOTH boxes. Leave these unset on staging unless a test
# account is deliberately in play, or the staging RUMI will reach whatever the key can see.
STRIPE_ENABLED=false
STRIPE_PLATFORM_API_KEY=
STRIPE_CONNECTED_ACCOUNT_ID=
