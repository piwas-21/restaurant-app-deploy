# Copy to .env and fill in. .env is git-ignored. Used by docker-compose.prod.yml.

# --- Which box this is (tenant provisioning guard) ---
# provision-tenant.sh/deprovision-tenant.sh refuse to run a tenant whose
# registry entry names a different box (and refuse to guess when unset).
BOX_ROLE=prod

# --- Image versions pulled from GHCR (per service) ---
# "latest" tracks the current prod (main). deploy.sh persists whatever tag it
# deploys here, so a rollback survives restarts. Pin a specific build for a
# rollback, e.g. BACKEND_TAG=sha-<commit> or FRONTEND_TAG=v1.2.3.
BACKEND_TAG=latest
FRONTEND_TAG=latest

# --- Postgres (fresh DB; you pick these) ---
POSTGRES_USER=rumi
POSTGRES_DB=restaurantdb
# Generate: openssl rand -base64 32   (avoid characters that break the connection string, e.g. trim '/+=')
POSTGRES_PASSWORD=CHANGE_ME

# Note: NEXT_PUBLIC_* (API URL, Google client ID) are baked into the frontend
# image at CI build time — they are NOT set here. To change them, edit the
# frontend repo's build-image.yml and rebuild.

# --- Developer Portal Basic Auth (/dev-portal) ---
# Bcrypt hash, NOT the plaintext password. Generate on the box:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'CHOOSE_A_STRONG_PASSWORD'
# IMPORTANT: double every literal $ before pasting here (e.g. $2a$14$Gkg... ->
# $$2a$$14$$Gkg...) — Compose interpolates .env values, and an unescaped $ can
# get silently swallowed as an undefined variable reference, corrupting the
# hash. See DEPLOYMENT.md's Developer Portal section for the full explanation.
# Rotate by regenerating the hash and recreating the caddy service.
DEV_PORTAL_AUTH_HASH=CHANGE_ME

# --- Error tracking (Sentry — DEV-PHASES W3) ---
# Empty = disabled (the SDK is a no-op). Enabling server-side capture is just
# this DSN + a recreate of frontend + backend (no image rebuild). DSN is Sentry
# SaaS EU (non-secret by design; self-host later = swap this value — see
# DEPLOYMENT.md).
SENTRY_DSN=
SENTRY_ENVIRONMENT=prod

# --- Fleet observability roll-up (Track S; printer-app → backend → sofra /admin/fleet) ---
# Shared bearer secret each tenant backend's FleetSummaryPushService presents to sofra's
# /api/telemetry/fleet ingest route (openssl rand -hex 32). MUST match the same key on the
# sofra box. Flowed into every tenant .env by provision-tenant.sh — set it ONCE per box and
# new tenants push automatically. Unset -> tenant backends stay inert (no push).
PRINTER_TELEMETRY_SECRET=

# --- Tenant→diner Stripe Connect (ADR-011 Job B, SOFRA-PAYMENTS-PLAN §4) ---
# RUMI's own online-payment wiring. All three are REQUIRED TOGETHER: the backend's gateway
# reports IsConfigured only when Enabled is true AND both values are non-empty, so leaving any
# one of them unset keeps online payment hidden at checkout rather than half-working.
#
# Distinct from Sofra's own Mollie billing, which this never touches. Funds settle DIRECTLY to
# the restaurant's Stripe balance — Connect Standard means the restaurant owns the account and
# its payouts outright, and by default Sofra takes no commission — see STRIPE_COMMISSION_BPS
# below.
#
# STRIPE_PLATFORM_API_KEY is the BOX's shared restricted key, not a per-tenant one: a Stripe
# restricted key cannot be bound to a single acct_, so it is narrowed by permission
# (checkout_session_write, payment_intent_read, charges_read — and deliberately NO refunds
# write) and by an Access policy pinning it to the box IPs. Same rail as
# PRINTER_TELEMETRY_SECRET above.
#
# STRIPE_CONNECTED_ACCOUNT_ID is RUMI's own acct_..., which only exists once the restaurant has
# completed Stripe's KYC onboarding. Setting STRIPE_ENABLED=true without it does nothing.
#
# ⚠️ docker-compose.prod.yml runs on BOTH boxes. Leave these unset on staging unless a test
# account is deliberately in play, or the staging RUMI will reach whatever the key can see.
STRIPE_ENABLED=false
STRIPE_PLATFORM_API_KEY=
STRIPE_CONNECTED_ACCOUNT_ID=

# --- Sofra's per-transaction commission on the Stripe wiring above ---
# Basis points sent to Stripe as `application_fee_amount` on a tenant's online payment —
# 100 = 1.00%. Default 0 means NO commission: at 0 the backend does not send the
# application_fee_amount parameter to Stripe at all, rather than sending a zero value.
# This must ship INERT — every existing tenant stays at 0 until someone deliberately
# raises it.
#
# The backend refuses anything above 1000 bps (10%). That ceiling is a safety guard, not
# a preference: Stripe does not reject an oversized application fee, it silently CAPS it
# at 100% of the order instead (measured 2026-09-04) — so a fat-fingered value here would
# not error, it would just take the whole order.
STRIPE_COMMISSION_BPS=0

# --- Sign in with Apple (mobile app; backend "Authentication:Apple") ---
# NOTHING TO SET HERE, on either box. The accepted `aud` is the iOS bundle id of the RUMI
# app (`com.rumirestaurant.app`, from rumi-mobile/app.json) — a PUBLIC identifier shipped
# inside the app binary, not a secret — so it lives in tracked config as the compose
# default in docker-compose.prod.yml, not in this file and not in app-secrets.json.
#
# It is listed here because the backend fails CLOSED: since backend #406 it verifies the
# Apple identity token, and with no client id configured every POST /api/Auth/apple-login
# is refused with 503 AppleLoginUnavailable. Setting the line below EMPTY is harmless —
# compose's `:-` falls back to the default on an empty value as well as an unset one — so
# the way a box loses Apple login is an un-synced release, not a bad .env, and deploy.sh's
# preflight warns when the resolved config carries no audience at all.
# Uncomment ONLY to override, e.g. the day the bundle id changes and the fix cannot wait
# for a release of this repo.
#APPLE_IOS_BUNDLE_ID=com.rumirestaurant.app
# Slot 1: the Apple *web* Service ID, for when Sign in with Apple ships on the website.
# Blank/absent = the app is the only accepted audience.
#APPLE_WEB_SERVICE_ID=

# --- Reservation quick-action mail links (backend "ReservationQuickActions") ---
# NOTHING TO SET HERE. The approve / reject buttons in the restaurant's new-booking alert mail
# are signed since backend #410; a token-LESS link from a mail sent BEFORE that release is still
# honoured while its own booking is younger than the grace window (14 days). The cutoff below —
# the instant the release image began serving on prod — is what stops that window from also
# covering bookings made AFTER the release, which would leave backend #402 (a guest approving
# their own table) reachable for two more weeks. It is a public timestamp, not a secret, so it
# ships as the compose default in docker-compose.prod.yml.
#
# THE FOLLOW-UP, ~2 weeks after the release: once the old alert mails are drained — no
# "Accepted a LEGACY unsigned quick-…" warning in the backend log for a few days — set
#     RESERVATION_QUICK_ACTIONS_LEGACY_GRACE_DAYS=0
# here and `docker compose -f docker-compose.prod.yml up -d backend`. That retires the
# token-less path entirely, with no release of this repo. See DEPLOYMENT.md
# §"Reservation quick-action links".
#
# Do not leave either line present-but-empty as a way to unset them: compose's `:-` substitutes
# the default on an empty value too, so an empty line is inert (and for the day count that is a
# mercy — an empty integer would make the backend THROW on the first link somebody opens).
#RESERVATION_QUICK_ACTIONS_LEGACY_CUTOFF_UTC=2026-08-25T00:52:24Z
#RESERVATION_QUICK_ACTIONS_LEGACY_GRACE_DAYS=14

# --- Platform sending domain (EMAIL-IDENTITY-PLAN) ---
# The Resend-verified domain every SCRIPT-PROVISIONED tenant sends from, e.g.
# `send.sofrapiwas.com`. provision-tenant.sh renders `<slug>@<this>` as the
# tenant's FromEmail, keeping the restaurant's own name as the display name:
#
#     From: Kebab House <kebabhouse@send.sofrapiwas.com>
#
# so the guest sees the restaurant, not the vendor, while one verified domain
# covers every tenant. A tenant that later brings its OWN verified domain
# overrides this per-entry with `mail_from:` in tenants/registry.yml.
#
# ⚠️ UNSET IS NOT NEUTRAL, and the failure is not a bounce. With this empty,
# provisioning falls back to Resend's shared `onboarding@resend.dev`, which
# Resend answers **403 for every recipient except the account owner's own
# address** — so the tenant can email exactly one person on earth. Password
# resets surface that as an HTTP 502; email verification and the order and
# reservation confirmations the tenant's guests expect fail SILENTLY, because
# they are swallowed so a dead mailer cannot fail a booking. provision-tenant.sh
# warns loudly rather than refusing, because a tenant with broken mail is still
# better than no tenant — but it is NOT a state to hand a paying customer.
#
# Setting this requires a Resend plan that allows a second domain (free tier is
# ONE, already spent on rumirestaurant.ch) and the DKIM/SPF records published by
# hand — sofrapiwas.com's zone is not writable through domainio-dns.sh.
PLATFORM_MAIL_DOMAIN=

# --- Sofra's own registration details (sofra ADR-013) ---
# Printed on every invoice AND on the public /legal imprint, from this one source
# so the two can never disagree. Not secrets — a KVK and a VAT number are public
# registry data required on both.
#
# Unset is NOT neutral: sofra refuses to issue ANY invoice until all of these are
# set. That is deliberate — a placeholder KVK number on a real invoice looks
# finished, which is worse than no invoice. /admin/invoices names what is missing.
#
# SOFRA_LEGAL_EMAIL must be a mailbox that RECEIVES: the imprint contact, the
# GDPR data-subject route and "ask us for the terms" all run through it. Check the
# domain has an MX record before setting it.
#
# SOFRA_VAT_NUMBER is also sent to VIES as the requester — the only way a check
# returns a consultation reference, which is the evidence a reverse charge rests on.
SOFRA_LEGAL_NAME=
SOFRA_LEGAL_ADDRESS=
SOFRA_LEGAL_ADDRESS_2=
SOFRA_LEGAL_POSTAL=
SOFRA_LEGAL_CITY=
SOFRA_LEGAL_COUNTRY=NL
SOFRA_LEGAL_EMAIL=
SOFRA_KVK=
SOFRA_VAT_NUMBER=
SOFRA_IBAN=
SOFRA_INVOICE_SERIES=SP

# --- Backup agent (box -> sofra control plane) ---
# Shared bearer this box's backup-agent.sh presents to the control plane's
# POST /api/telemetry/backups (inventory) and GET /api/backups/jobs (work queue).
# `openssl rand -hex 32`. MUST match BACKUP_AGENT_SECRET on the sofra box.
#
# DIRECTION IS THE DESIGN: every credential points BOX -> SOFRA. The control plane
# never holds anything that can reach a box, so a compromised public container can
# ask for a backup and can never provision, deprovision or log into anything
# (ADR-012 invariant 2). That is also why sofra is NOT given a GitHub
# `Actions: write` token to dispatch a backup workflow — that scope cannot be
# narrowed to one workflow, so it would equally dispatch deprovision --drop-db.
#
# WHERE IT IS READ: backup-agent.sh runs on the HOST from cron (*/5), reading this
# file directly — it is not a container, so nothing else is needed on a tenant box.
# The SOFRA container needs the same value to VERIFY the bearer, and for that it is
# declared in docker-compose.prod.yml (a .env var does not reach a container on its
# own). Unset -> the agent exits silently and the route stays inert. Safe to ship.
BACKUP_AGENT_SECRET=
# Where to report. Default https://sofrapiwas.com; override to point a box at a
# staging control plane.
BACKUP_AGENT_URL=
# Whether this box will execute `delete` jobs from the control plane. OFF unless
# it is exactly `true`, deliberately: sofra is the internet-facing half of the
# system, and with this false the worst a compromise of it can do through this
# channel is ask for MORE backups. Whole-tenant erasure is never a job at all —
# it is a deliberate on-box run of backup-erase-tenant.sh.
BACKUP_AGENT_ALLOW_DELETE=false
# --- Off-box reporting (ONE box only) ---
# The restic repository this box can open, so the agent can report the copies that
# are NOT on the box. Leave EMPTY everywhere except the box that physically holds
# the repository and its key.
#
# MEASURED 2026-08-21: only prod has the restic binary and the repository password;
# staging has neither, and the repo directory it hosts is prod's — encrypted and
# opaque to it. Prod holds `restic-staging`, which is where the STAGING box's
# per-tenant dumps land. So the box that reports a tenant's off-box copy is not the
# box that runs the tenant, and that is fine: the ingest's key is (box, location,
# ref) and the control plane groups by tenant.
#
# WHY IT MATTERS: without this the agent reports every artifact it finds by walking
# its own filesystem, i.e. `location: local`, always — so the control plane's
# "every copy sits on the box that runs this tenant" was permanently true for
# everyone while the off-box copies demonstrably existed (sofra ADR-014 D5).
#
# FAILURE IS SILENCE, NOT A PARTIAL PUSH: if the repository cannot be read the agent
# pushes NOTHING that tick, because the ingest prunes what a push stops listing —
# half an answer would delete the other half. The box then goes quiet and the
# twice-daily alarm says so.
BACKUP_AGENT_RESTIC_REPO=
# Which tag series to read, space separated. Default: `staging-dumps tenant-archive`
# — the two backup-offsite.sh writes into the local repo on prod.
BACKUP_AGENT_RESTIC_TAGS=
# Where RESTIC_PASSWORD lives. Default /root/.rumi-backup-env (mode 600, the file
# backup-offsite.sh already sources). Do NOT copy the password into this .env.
BACKUP_AGENT_RESTIC_ENV=
# How long a DEPARTED tenant's consolidated archive is kept (calendar months).
# Default 24 — see DEPLOYMENT.md §Backups & restore for why that number and not
# "forever". Applies to backup-archive-tenant.sh --prune and to the restic
# --tag tenant-archive series in backup-offsite.sh.
ARCHIVE_KEEP_MONTHS=24
