# RUMI STAGING reverse proxy — automatic HTTPS via Let's Encrypt.
# Mounted on the staging box only (CADDYFILE=./Caddyfile.staging in that box's .env;
# see docker-compose.prod.yml). Routing mirrors the prod Caddyfile exactly so staging
# is a faithful rehearsal of prod — the ONLY difference is the site address.
#
# Host: {$STAGING_DOMAIN} is injected from the staging box's .env via the caddy
# service in docker-compose.prod.yml (default = staging.fooderist.com). It must be a
# name in a zone WE control, A-record'd to this box, because Caddy answers a Let's
# Encrypt HTTP-01 challenge for it. The box's Netcup reverse-DNS name
# (*.megasrv.de) is NOT such a name — we cannot serve a challenge in the provider's
# zone, so Caddy holds no certificate, that host never becomes a site address here,
# and any HTTPS request for it dies with `tlsv1 alert internal error` (deploy #146).
# To move to a SaaS brand domain later, just set STAGING_DOMAIN in the box's .env —
# no edit to this file.

{$STAGING_DOMAIN} {
	encode zstd gzip

	# Uploaded product/category images — served straight off the backend's volume.
	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}

	# Frontend's version-aggregation route — must win over /api/* (Caddy matches by
	# path specificity, so this is safe regardless of order).
	handle /api/frontend/version {
		reverse_proxy frontend:3000
	}

	# API + SSE order-event stream. flush_interval -1 disables buffering so SSE reaches
	# the cashier/kitchen UIs immediately.
	handle /api/* {
		reverse_proxy backend:8080 {
			flush_interval -1
		}
	}

	# Internal developer/operator tool, gated by its own Basic Auth (hash from the box's
	# .env, never in git). Exact /dev-portal + /dev-portal/* only.
	@devportal path /dev-portal /dev-portal/*
	handle @devportal {
		basic_auth {
			dev {env.DEV_PORTAL_AUTH_HASH}
		}
		reverse_proxy frontend:3000
	}

	# Ops-only container log viewer (Dozzle) at /logs — enforces its own login.
	@logs path /logs /logs/*
	handle @logs {
		reverse_proxy dozzle:8080
	}

	# Next.js app
	handle {
		reverse_proxy frontend:3000
	}
}

# ── Sofra marketing site (Track S) ─────────────────────────────────────────────
# {$SOFRA_DOMAIN} / {$SOFRA_WWW_DOMAIN} come from the staging box's .env via the
# caddy service. On a box that doesn't set them, compose injects http:// placeholder
# hosts (see docker-compose.prod.yml) so this file always parses and Caddy never
# attempts TLS for an unset address. The sofra container only runs when the box
# opts in with COMPOSE_PROFILES=sofra; if it's down, Caddy answers 502 here without
# affecting the RUMI staging site above.

{$SOFRA_DOMAIN} {
	encode zstd gzip
	reverse_proxy sofra:3000
}

# www -> apex, preserving path/query.
{$SOFRA_WWW_DOMAIN} {
	redir https://{$SOFRA_DOMAIN}{uri} permanent
}

# ── sofra STAGING (develop-tracking control plane) ────────────────────────────
# Same shape as the block above, one addition: X-Robots-Tag. `robots.ts` already
# disallows everything on a non-canonical host (lib/seo.ts IS_CANONICAL_SITE), and this
# is the belt to that pair of braces — a crawler that never fetches robots.txt still
# gets told, on every response, not to index a public twin of the marketing site.
#
# Empty {$SOFRA_STAGING_DOMAIN} resolves to the http:// placeholder compose injects, so
# this file parses on a box that does not run the profile.
{$SOFRA_STAGING_DOMAIN} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow, noarchive"
	reverse_proxy sofra-staging:3000
}

# ── Sofra tenant instances (S14 provisioning v1, sofra ADR-001/003) ───────────
# Per-tenant site blocks rendered on the box by provision-tenant.sh into
# caddy-tenants/ (dir-mounted at /etc/caddy/tenants). The committed
# 00-placeholder.caddy guarantees the glob always matches, so this file parses
# on a box with zero tenants. Apply changes with a plain `caddy reload` —
# the directory mount makes new/removed files visible without a recreate.
import /etc/caddy/tenants/*.caddy
