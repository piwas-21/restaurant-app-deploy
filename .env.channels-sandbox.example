# Copy on STAGING ONLY to .env.channels-sandbox (mode 600). Never use an Uber production credential.
# Generate independent hex-only database passwords. Double literal $ as $$ for Compose interpolation.
CHANNELS_OWNER_PASSWORD=replace-with-independent-random-hex
CHANNELS_INGRESS_PASSWORD=replace-with-independent-random-hex
CHANNELS_SANDBOX_IMAGE=ghcr.io/piwas-21/sofra-channel-gateway:sha-REVIEWED_COMMIT
UBER_SANDBOX_CLIENT_ID=replace-with-test-app-client-id
UBER_SANDBOX_CLIENT_SECRET=
UBER_SANDBOX_STORE_ID=00000000-0000-0000-0000-000000000000
# Opt in only after migration 002, grants, secret generation and HTTPS validation.
CHANNELS_CONSOLE_ENABLED=false
CHANNELS_CONSOLE_ORIGIN=https://channels-sandbox.sofrapiwas.com
CHANNELS_CONSOLE_ACCESS_HASH=
CHANNELS_CONSOLE_ENCRYPTION_KEY=
